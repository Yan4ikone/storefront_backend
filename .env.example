# Скопируйте этот файл в .env и, если нужно, поправьте значения.
# Пароль и порт здесь — только для локальной разработки, совпадают с docker-compose.yml.

DATABASE_URL="postgresql://storefront:storefront@localhost:5432/storefront?schema=public"

# На каком порту слушает бэкенд
PORT=3001

# Разрешённый источник для CORS — адрес, на котором работает фронтенд (Next.js)
CORS_ORIGIN=http://localhost:3000

# Секрет для подписи JWT (вход покупателей и админки, см. src/auth). Один и тот
# же секрет должен оставаться неизменным на сервере — если его сменить, все
# уже выданные токены (в т.ч. активные сессии в браузерах) станут недействительны.
# Сгенерировать случайное значение можно командой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string

# Данные первого администратора — создаётся/обновляется командой `npm run seed`
# (см. prisma/seed.ts). Не влияет на уже существующие аккаунты с другим email.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
