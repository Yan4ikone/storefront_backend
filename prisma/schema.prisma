// Схема БД — соответствует разделу 5 плана архитектуры, упрощена под текущий этап
// (без Warehouse/Organization/многоуровневых цен — см. принятые решения, раздел 11).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  manager
  admin
}

// Покупатель или сотрудник (менеджер/администратор) — одна таблица с ролью,
// отдельного контура для B2B/внешних организаций нет (см. раздел 11 плана).
// Регистрация — по email ИЛИ телефону (хотя бы одно обязательно, проверяется
// в AuthService), без подтверждения письмом/смс — упрощение для этого этапа.
model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  name         String?
  role         UserRole   @default(customer)
  // Баланс в рублях — пока просто витрина/заглушка (правка от пользователя):
  // отображается в профиле, меняет его вручную только админ (PATCH
  // /admin/users/:id/balance). Кнопка "Пополнить" на фронте ничего не списывает
  // по-настоящему — реальное пополнение подключится вместе с платёжным
  // провайдером (раздел 8 плана), тогда это поле станет итогом реальных платежей.
  balance      Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  favorites    Favorite[]

  @@map("users")
}

// Избранное ("сердечко" на карточке товара) — простая связка пользователь/товар.
// Если товар удаляют из каталога — его закладки у всех тоже исчезают (Cascade),
// это нормально: ссылаться на несуществующий товар в избранном смысла нет.
model Favorite {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  product     Product  @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  productSlug String
  createdAt   DateTime @default(now())

  @@unique([userId, productSlug])
  @@map("favorites")
}

model Category {
  slug     String    @id
  name     String
  // Ключ иконки Lucide (см. lib/icon-map.ts на фронте), например "BatteryCharging".
  icon     String
  // Подпункты для всплывающего списка на витрине — временное решение до реальных подкатегорий.
  items    String[]
  products Product[]

  @@map("categories")
}

model Product {
  slug          String      @id
  name          String
  // Совместимость как отображается на карточке (свободный текст, как раньше) —
  // например "iPhone 12 / 12 Pro". Для фильтра по модели устройства используется
  // отдельная связь compatibilityModels (см. CompatibilityModel ниже); это поле
  // не заменяется, просто перестаёт быть единственным источником данных о совместимости.
  compatibility String
  price         Int
  oldPrice      Int?
  badge         String?
  // Артикул — внутренний код товара (для поиска и, в будущем, сверки с
  // CRM/учётной системой поставщика). Пока не привязан ни к какому реальному
  // прайс-листу — присваивается вручную в админке, схема кодов условная.
  article       String?     @unique
  description   String
  // Характеристики товара: [{ label, value }, ...]
  specs         Json
  // "В наличии" / "под заказ" — выставляется вручную в админке. Не связано ни
  // с каким складским учётом или CRM: пользователь планирует со временем
  // сверять это поле с реальной базой поставщика/CRM, но сейчас это просто
  // ручной флаг для покупателя.
  inStock       Boolean     @default(true)
  // Ожидаемый срок/дата поступления — свободный редактируемый текст (например
  // "20.09" или "5-7 дней"), задаётся вручную в админке. Практический смысл
  // имеет прежде всего для товаров "под заказ" (inStock = false), но поле не
  // связано с inStock жёстко и не привязано к реальной логистике/поставщику.
  expectedDelivery String?
  // Фото товара — пути к уже обрезанным/отресайзенным файлам (см.
  // AdminCatalogService.uploadImage), в порядке добавления; первое — обложка
  // карточки. Пока хранится на диске самого бэкенда (backend/uploads) — при
  // переезде на Timeweb Object Storage поменяется только то, что пишется в
  // этот массив (сами пути), не сама модель данных.
  images        String[]    @default([])
  category      Category    @relation(fields: [categorySlug], references: [slug])
  categorySlug  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  compatibilityModels ProductCompatibility[]
  favoritedBy   Favorite[]

  @@index([categorySlug])
  @@map("products")
}

// Модель устройства (производитель/серия/модель) для фильтра "Совместимость" в
// поиске и на странице раздела — см. раздел 2.1 и раздел 5 плана архитектуры.
// Заполняется по общепринятой номенклатуре рынка (это не авторский контент).
model CompatibilityModel {
  slug     String                 @id
  brand    String
  series   String?
  model    String
  products ProductCompatibility[]

  @@index([brand])
  @@map("compatibility_models")
}

// Связь товара с моделями устройств, с которыми он совместим (многие-ко-многим).
// Сделана явной таблицей (а не implicit m2m), чтобы можно было расширить полями
// позже (например, "рекомендовано"/"проверено") без миграции на другую схему связи.
model ProductCompatibility {
  product                Product            @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  productSlug            String
  compatibilityModel     CompatibilityModel @relation(fields: [compatibilityModelSlug], references: [slug], onDelete: Cascade)
  compatibilityModelSlug String

  @@id([productSlug, compatibilityModelSlug])
  @@index([compatibilityModelSlug])
  @@map("product_compatibility")
}

// new -> confirmed -> assembled -> shipped -> delivered — линейный прогресс,
// показывается покупателю как линия с точками (см. storefront OrderProgress).
// cancelled — отдельно, вне линии, в любой момент (см. Order.cancellationRequested).
enum OrderStatus {
  new
  confirmed
  assembled
  shipped
  delivered
  cancelled
}

// Заказ без привязки к пользователю — авторизации ещё нет (см. раздел 10 плана,
// этап B4/Users & Auth). Оплаты и интеграции служб доставки тоже пока нет (нет
// подключённых аккаунтов ЮKassa/СДЭК) — заказ создаётся как заявка со статусом
// "new", дальше менеджер связывается с покупателем сам и ведёт статус вручную.
model Order {
  id             String      @id @default(cuid())
  // Короткий номер для разговора с покупателем/поиска среди тысячи заказов
  // ("назовите, пожалуйста, номер заказа") — отдельно от непрозрачного id.
  number         Int         @unique @default(autoincrement())
  status         OrderStatus @default(new)
  // Покупатель попросил отменить уже подтверждённый (не "новый") заказ — сам
  // заказ остаётся в текущем статусе, пока менеджер/админ не подтвердит отмену
  // (см. OrdersService.cancel). Для "новых" заказов отмена покупателем удаляет
  // заказ сразу, без этого флага.
  cancellationRequested Boolean @default(false)
  customerName   String
  phone          String
  email          String?
  // "pickup" (самовывоз) | "courier" (курьер/ТК — адрес обязателен, см. DTO)
  deliveryMethod String
  address        String?
  comment        String?
  // Сумма заказа на момент оформления (сумма price * qty по позициям) —
  // хранится отдельно, чтобы не пересчитывать задним числом при смене цен в каталоге.
  itemsTotal     Int
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  // Необязательная связь с аккаунтом — оформить заказ можно и без входа
  // (гостевой чекаут сохранён сознательно), но если покупатель вошёл, его
  // заказ попадает в личный кабинет (GET /users/me/orders).
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  // Если при оформлении покупатель выбрал "раздельно" для товаров в наличии и
  // "под заказ" — оба получившихся заказа получают один и тот же groupId,
  // чтобы на странице подтверждения и в истории было видно, что это части
  // одной покупки. У обычного (нераздельного) заказа — null.
  groupId        String?

  @@index([userId])
  @@index([groupId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id])
  orderId     String
  // Связь с товаром необязательная (SetNull) — заказ должен остаться читаемым,
  // даже если товар потом удалят из каталога.
  product     Product? @relation(fields: [productSlug], references: [slug], onDelete: SetNull)
  productSlug String?
  // Название, цена и наличие — снимок на момент заказа, не текущие значения из
  // каталога (товар мог после заказа изменить цену или появиться на складе).
  name        String
  price       Int
  qty         Int
  inStock     Boolean @default(true)

  @@index([orderId])
  @@map("order_items")
}
